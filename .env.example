# ============================================
# DoctorBook Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Mac/Linux)

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doctorbook_db
DB_USER=doctorbook_user
DB_PASSWORD=Doctorbook@2026
DB_SCHEMA=doctorbook_schema
DB_DIALECT=postgres

# JWT Authentication (change this secret in production!)
JWT_SECRET=doctorbook_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# CORS - frontend URL(s) allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Uploads
MAX_FILE_SIZE_MB=10
